{
  "name": "git-standup-bot",
  "version": "0.1.0",
  "description": "Production-grade TypeScript CLI for turning git activity into standup summaries.",
  "type": "module",
  "bin": {
    "git-standup-bot": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "audit": "npm audit --audit-level=moderate",
    "outdated": "npm outdated",
    "start": "node dist/bin.js"
  },
  "keywords": [
    "git",
    "standup",
    "cli",
    "typescript",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
